<?xml version="1.0" encoding="UTF-8"?>
<!-- DONO: Pessoa A. -->
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>AgroGest</display-name>

  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
  </session-config>

  <!--
    Todos os *.jsp:
    - recebem automaticamente o topo (taglibs c/fmt/fn + <html>, <head>, menu) e o rodapé;
    - são UTF-8;
    - NÃO podem ter scriptlets (<% %>): só EL + JSTL.
    Fragmentos reutilizáveis usam a extensão .jspf (não recebem topo/rodapé).
  -->
  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <scripting-invalid>true</scripting-invalid>
      <include-prelude>/WEB-INF/jspf/topo.jspf</include-prelude>
      <include-coda>/WEB-INF/jspf/rodape.jspf</include-coda>
      <default-content-type>text/html; charset=UTF-8</default-content-type>
    </jsp-property-group>
  </jsp-config>

  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/views/erro.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/erro.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/erro.jsp</location>
  </error-page>
</web-app>
