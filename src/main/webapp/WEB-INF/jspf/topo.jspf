<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="pt_PT"/>
<%-- DONO: Pessoa C. Incluído automaticamente em todos os *.jsp (ver web.xml). --%>
<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${empty titulo ? 'AgroGest' : titulo}"/> | AgroGest</title>
  <link rel="stylesheet" href="<c:url value='/css/estilo.css'/>">
</head>
<body>
<c:set var="u" value="${sessionScope.utilizador}"/>
<header class="barra nao-imprimir">
  <a class="marca" href="<c:url value='/'/>">AgroGest</a>
  <nav class="menu">
    <c:choose>
      <c:when test="${empty u}">
        <a href="<c:url value='/login'/>">Entrar</a>
        <a href="<c:url value='/registo'/>">Registar</a>
      </c:when>
      <c:when test="${u.admin}">
        <a href="<c:url value='/admin/dashboard'/>">Dashboard</a>
        <a href="<c:url value='/admin/fornecedores'/>">Fornecedores</a>
        <a href="<c:url value='/admin/produtos'/>">Produtos</a>
        <a href="<c:url value='/admin/campanhas'/>">Campanhas</a>
        <a href="<c:url value='/admin/cultivos'/>">Cultivos</a>
        <a href="<c:url value='/admin/colheitas'/>">Colheitas</a>
        <a href="<c:url value='/admin/listagens'/>">Listagens</a>
        <a href="<c:url value='/admin/relatorios'/>">Relatórios</a>
        <a href="<c:url value='/admin/persistencia'/>">Persistência</a>
      </c:when>
      <c:otherwise>
        <a href="<c:url value='/catalogo'/>">Catálogo</a>
        <a href="<c:url value='/carrinho'/>">Carrinho (<c:out value="${empty sessionScope.carrinho ? 0 : sessionScope.carrinho.totalItens}"/>)</a>
        <a href="<c:url value='/minhas-compras'/>">Minhas compras</a>
      </c:otherwise>
    </c:choose>
    <c:if test="${not empty u}">
      <span class="utilizador"><c:out value="${u.nome}"/></span>
      <a href="<c:url value='/logout'/>">Sair</a>
    </c:if>
  </nav>
</header>
<main class="conteudo">
<c:if test="${not empty sessionScope.flashOk}">
  <div class="alerta ok"><c:out value="${sessionScope.flashOk}"/></div>
  <c:remove var="flashOk" scope="session"/>
</c:if>
<c:if test="${not empty sessionScope.flashErro}">
  <div class="alerta erro"><c:out value="${sessionScope.flashErro}"/></div>
  <c:remove var="flashErro" scope="session"/>
</c:if>
<c:if test="${not empty mensagem}"><div class="alerta ok"><c:out value="${mensagem}"/></div></c:if>
<c:if test="${not empty erro}"><div class="alerta erro"><c:out value="${erro}"/></div></c:if>
