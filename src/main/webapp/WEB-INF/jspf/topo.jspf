<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="pt_PT"/>
<%-- DONO: Pessoa C. Incluído automaticamente em todos os *.jsp (ver web.xml). --%>
<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#14301d">
  <title><c:out value="${empty titulo ? 'AgroGest' : titulo}"/> | AgroGest</title>
  <link rel="icon" type="image/svg+xml" href="<c:url value='/assets/img/favicon.svg'/>">
  <link rel="icon" type="image/png" sizes="32x32" href="<c:url value='/assets/img/favicon-32.png'/>">
  <link rel="apple-touch-icon" sizes="180x180" href="<c:url value='/assets/img/apple-touch-icon.png'/>">
  <link rel="stylesheet" href="<c:url value='/css/estilo.css'/>">
</head>
<body class="${empty sessionScope.utilizador ? 'pagina-auth' : ''}">
<%@ include file="/WEB-INF/jspf/icons.jspf" %>
<c:set var="u" value="${sessionScope.utilizador}"/>
<c:choose>
  <c:when test="${empty u}">
    <main class="auth">
      <div class="auth-marca">
        <a class="marca-auth" href="<c:url value='/'/>">
          <img class="marca-auth-icone" src="<c:url value='/assets/img/logo-marca.svg'/>" alt="AgroGest" width="56" height="56">
          <span class="marca-auth-texto"><span class="marca-agro">Agro</span><span class="marca-gest">Gest</span></span>
        </a>
        <p class="auth-subtitulo">Sistema de Gestão Agrícola</p>
      </div>
      <c:if test="${not empty sessionScope.flashOk}">
        <div class="alerta ok"><c:out value="${sessionScope.flashOk}"/></div>
        <c:remove var="flashOk" scope="session"/>
      </c:if>
      <c:if test="${not empty sessionScope.flashErro}">
        <div class="alerta erro"><c:out value="${sessionScope.flashErro}"/></div>
        <c:remove var="flashErro" scope="session"/>
      </c:if>
      <c:if test="${not empty mensagem}"><div class="alerta ok"><c:out value="${mensagem}"/></div></c:if>
  </c:when>
  <c:otherwise>
    <%-- ===================== NAVBAR AUTENTICADA ===================== --%>
    <c:set var="sp" value="${requestScope['jakarta.servlet.forward.servlet_path']}"/>
    <header class="barra nao-imprimir">
      <c:choose>

        <%-- ===================== NAVBAR CLIENTE ===================== --%>
        <c:when test="${not u.admin}">
          <%-- Grelha 1fr auto 1fr: utilizador | marca | carrinho --%>
          <div class="barra-cliente">

            <%-- Coluna esquerda: menu do utilizador --%>
            <div class="barra-esq">
              <button class="btn-user" data-painel="painel-user-cliente" aria-expanded="false" aria-haspopup="true" aria-controls="painel-user-cliente">
                <svg class="icone" aria-hidden="true"><use href="#i-utilizador"/></svg>
                <span class="btn-user-nome"><c:out value="${fn:split(u.nome, ' ')[0]}"/></span>
                <svg class="icone" aria-hidden="true"><use href="#i-seta-baixo"/></svg>
              </button>
              <div id="painel-user-cliente" class="dropdown-painel" hidden>
                <div class="dropdown-cab">
                  <div class="user-avatar"><c:out value="${fn:toUpperCase(fn:substring(u.nome,0,1))}"/></div>
                  <div class="user-info">
                    <strong><c:out value="${u.nome}"/></strong>
                    <span class="muted" style="font-size:0.85rem"><c:out value="${u.email}"/></span>
                    <span class="badge">Cliente</span>
                  </div>
                </div>
                <hr class="dropdown-sep">
                <a href="<c:url value='/minhas-compras'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-recibo"/></svg>
                  Minhas compras
                </a>
                <hr class="dropdown-sep">
                <a href="<c:url value='/logout'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-sair"/></svg>
                  Sair
                </a>
              </div>
            </div>

            <%-- Coluna central: marca --%>
            <a class="marca marca-central" href="<c:url value='/'/>">
              <img class="marca-icone" src="<c:url value='/assets/img/logo-marca-branca.svg'/>" alt="" width="28" height="28">
              <span>AgroGest</span>
            </a>

            <%-- Coluna direita: carrinho --%>
            <div class="barra-dir">
              <a href="<c:url value='/carrinho'/>" class="btn-carrinho" aria-label="Carrinho, ${empty sessionScope.carrinho ? 0 : sessionScope.carrinho.totalItens} itens">
                <svg class="icone" aria-hidden="true"><use href="#i-carrinho"/></svg>
                <span class="carrinho-badge">${empty sessionScope.carrinho ? 0 : sessionScope.carrinho.totalItens}</span>
              </a>
            </div>

          </div>
        </c:when>

        <%-- ===================== NAVBAR ADMIN ===================== --%>
        <c:otherwise>
          <%-- Linha 1: utilizador à esquerda + marca centrada + hambúrguer à direita --%>
          <div class="barra-admin-linha1">

            <%-- Utilizador --%>
            <div class="barra-esq">
              <button class="btn-user" data-painel="painel-user-admin" aria-expanded="false" aria-haspopup="true" aria-controls="painel-user-admin">
                <svg class="icone" aria-hidden="true"><use href="#i-utilizador"/></svg>
                <span class="btn-user-nome"><c:out value="${fn:split(u.nome, ' ')[0]}"/></span>
                <svg class="icone" aria-hidden="true"><use href="#i-seta-baixo"/></svg>
              </button>
              <div id="painel-user-admin" class="dropdown-painel" hidden>
                <div class="dropdown-cab">
                  <div class="user-avatar"><c:out value="${fn:toUpperCase(fn:substring(u.nome,0,1))}"/></div>
                  <div class="user-info">
                    <strong><c:out value="${u.nome}"/></strong>
                    <span class="muted" style="font-size:0.85rem"><c:out value="${u.email}"/></span>
                    <span class="badge">Administrador</span>
                  </div>
                </div>
                <hr class="dropdown-sep">
                <a href="<c:url value='/admin/persistencia'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-cofre"/></svg>
                  Persistência
                </a>
                <hr class="dropdown-sep">
                <a href="<c:url value='/logout'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-sair"/></svg>
                  Sair
                </a>
              </div>
            </div>

            <%-- Marca centrada --%>
            <a class="marca marca-central" href="<c:url value='/'/>">
              <img class="marca-icone" src="<c:url value='/assets/img/logo-marca-branca.svg'/>" alt="" width="28" height="28">
              <span>AgroGest</span>
            </a>

            <%-- Hambúrguer (só mobile) --%>
            <div class="barra-dir">
              <button id="hamburguer" class="btn-user" aria-label="Abrir navegação" aria-expanded="false" aria-controls="nav-admin">
                <svg class="icone" aria-hidden="true"><use href="#i-menu"/></svg>
              </button>
            </div>
          </div>

          <%-- Linha 2: navegação centrada --%>
          <nav id="nav-admin" class="nav-admin" aria-expanded="false">
            <%-- Dashboard --%>
            <a href="<c:url value='/admin/dashboard'/>"
               class="nav-link${fn:startsWith(sp,'/admin/dashboard') ? ' nav-ativo' : ''}">
              <svg class="icone" aria-hidden="true"><use href="#i-dashboard"/></svg>
              Dashboard
            </a>

            <%-- Gestão ▾ --%>
            <div class="nav-grupo">
              <button class="nav-link nav-dropdown-btn" data-painel="painel-gestao" aria-expanded="false" aria-haspopup="true">
                Gestão
                <svg class="icone" aria-hidden="true"><use href="#i-seta-baixo"/></svg>
              </button>
              <div id="painel-gestao" class="dropdown-painel" hidden>
                <a href="<c:url value='/admin/produtos'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-caixa"/></svg>
                  Produtos
                </a>
                <a href="<c:url value='/admin/fornecedores'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-camiao"/></svg>
                  Fornecedores
                </a>
                <a href="<c:url value='/admin/campanhas'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-folha"/></svg>
                  Campanhas
                </a>
                <a href="<c:url value='/admin/cultivos'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-folha"/></svg>
                  Cultivos
                </a>
                <a href="<c:url value='/admin/colheitas'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-recibo"/></svg>
                  Colheitas
                </a>
              </div>
            </div>

            <%-- Listagens ▾ --%>
            <div class="nav-grupo">
              <button class="nav-link nav-dropdown-btn" data-painel="painel-listagens" aria-expanded="false" aria-haspopup="true">
                Listagens
                <svg class="icone" aria-hidden="true"><use href="#i-seta-baixo"/></svg>
              </button>
              <div id="painel-listagens" class="dropdown-painel" hidden>
                <a href="<c:url value='/admin/listagens/produtos'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-caixa"/></svg>
                  Produtos
                </a>
                <a href="<c:url value='/admin/listagens/fornecedores'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-camiao"/></svg>
                  Fornecedores
                </a>
                <a href="<c:url value='/admin/listagens/clientes'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-pessoas"/></svg>
                  Clientes
                </a>
                <a href="<c:url value='/admin/listagens/armazem'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-caixa"/></svg>
                  Armazém
                </a>
                <a href="<c:url value='/admin/listagens/compras'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-recibo"/></svg>
                  Compras detalhadas
                </a>
              </div>
            </div>

            <%-- Relatórios ▾ --%>
            <div class="nav-grupo">
              <button class="nav-link nav-dropdown-btn" data-painel="painel-relatorios" aria-expanded="false" aria-haspopup="true">
                Relatórios
                <svg class="icone" aria-hidden="true"><use href="#i-recibo"/></svg>
              </button>
              <div id="painel-relatorios" class="dropdown-painel" hidden>
                <a href="<c:url value='/admin/relatorios/clientes'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-pessoas"/></svg>
                  Clientes
                </a>
                <a href="<c:url value='/admin/relatorios/compraram'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-recibo"/></svg>
                  Que compraram
                </a>
                <a href="<c:url value='/admin/relatorios/assiduos'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-seta-direita"/></svg>
                  Mais assíduos
                </a>
                <a href="<c:url value='/admin/relatorios/sem-compras'/>" class="dropdown-item">
                  <svg class="icone" aria-hidden="true"><use href="#i-alerta"/></svg>
                  Sem compras
                </a>
              </div>
            </div>
          </nav>
        </c:otherwise>

      </c:choose>
    </header>
    <script defer src="<c:url value='/assets/js/app.js'/>"></script>
    <main class="conteudo">
      <c:if test="${not empty sessionScope.flashOk}">
        <div class="alerta ok"><c:out value="${sessionScope.flashOk}"/></div>
        <c:remove var="flashOk" scope="session"/>
      </c:if>
      <c:if test="${not empty sessionScope.flashErro}">
        <div class="alerta erro"><c:out value="${sessionScope.flashErro}"/></div>
        <c:remove var="flashErro" scope="session"/>
      </c:if>
      <c:if test="${not empty mensagem}"><div class="alerta ok"><c:out value="${mensagem}"/></div></c:if>
      <c:if test="${not empty erro}"><div class="alerta erro"><c:out value="${erro}"/></div></c:if>
  </c:otherwise>
</c:choose>
